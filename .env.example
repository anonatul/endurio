# Database — Supabase Postgres pooler
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Backend
PORT=5000
CLIENT_URL=http://localhost:5173

# Strava OAuth
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
REDIRECT_URI=http://localhost:5000/api/auth/strava/callback

# Sessions — express-session + connect-pg-simple
SESSION_SECRET=

# AI provider — AgentRouter (OpenAI-compatible Responses API)
AGENTROUTER_API_KEY=
AI_MODEL=gpt-5.6-sol
